# Firebase web app config.
# Copy this file to `.env` and fill in the values from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration → Config
#
# These VITE_-prefixed vars are embedded in the client bundle at build time.
# That is expected for Firebase web config (it is not a secret); your data is
# protected by Firestore security rules, not by hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# reCAPTCHA v3 site key for Firebase App Check (also public — it ships in the
# bundle). Register a reCAPTCHA v3 provider at Firebase console → App Check, then
# paste the SITE key here. The matching reCAPTCHA SECRET key is configured in the
# console, never here.
#
# Leaving this blank disables App Check for `npm run dev` only: `npm run build`
# FAILS without it, because Firebase enforces App Check on every AI Logic
# (Gemini) request from 2026-11-02, so an unattested bundle ships with the "Ask
# AI" and "Translate with AI" assists permanently broken. Use
# ALLOW_UNATTESTED_BUILD=1 for a deliberate local build without App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# App Check debug tokens — dev/test only, never used in a production build.
# Register one under Firebase console → App Check → Manage debug tokens, then put
# the SAME value in both vars: the VITE_-prefixed one reaches the browser for
# `npm run dev`, the unprefixed one is read by Playwright (test/e2e/fixtures.ts).
# Without them Firebase mints a throwaway token per reload that you would have to
# register by hand every session once enforcement is on.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
FIREBASE_APPCHECK_DEBUG_TOKEN=

# --- Server-side scripts only (NOT shipped to the browser) ---
# Path to a Firebase service-account JSON key, used by the Admin SDK in
# scripts/ (e.g. `npm run provision`). Generate one at:
#   Firebase console → Project settings → Service accounts → Generate new private key
# Unlike the VITE_ values above, this key IS a secret — keep it out of git
# (the default filename below is gitignored).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
